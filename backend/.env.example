# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# Server Configuration
PORT=3001

# MongoDB Connection
# Option 1: Local MongoDB
# MONGODB_URI=mongodb://localhost:27017/collateral-crypto

# Option 2: MongoDB Atlas (Cloud - Free tier available)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/collateral-crypto?retryWrites=true&w=majority

# Option 3: Docker MongoDB
# MONGODB_URI=mongodb://localhost:27017/collateral-crypto
MONGODB_URI=mongodb://localhost:27017/collateral-crypto

# Ethereum RPC URL (for reading contract state from backend)
# Same as contracts/.env - use Sepolia for testing
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Contract Addresses
# ⚠️  IMPORTANT: Update these after deploying contracts!
# Get addresses from contracts deployment output
COLLATERAL_LOCK_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VERIFICATION_NFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
LOAN_SECURITIZATION_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: Owner PRIVATE KEY (not address!) for on-chain writes (credit score update, token price update).
# Must be the private key of the VerificationNFT/CollateralLock owner (usually your deployer wallet).
# If not set, credit score is only stored in DB; token price update endpoint will not send tx.
# CONTRACT_OWNER_PRIVATE_KEY=0x...

# Optional: WETH contract address for token price cron (default token when none provided).
# WETH_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
